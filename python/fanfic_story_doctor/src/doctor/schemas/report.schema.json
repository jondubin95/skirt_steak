{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "lens", "items"],
  "properties": {
    "summary": { "type": "string" },
    "voice_profiles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/voice_profile" }
    },
    "lens": {
      "type": "array",
      "items": { "$ref": "#/$defs/lens" }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "lens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "state", "reason"],
      "properties": {
        "rule_id": { "type": "string" },
        "state": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["prose", "file"] },
        "paragraph_id": { "type": "string" },
        "quote": { "type": "string" },
        "span": {
          "type": ["array", "null"],
          "prefixItems": [{ "type": "integer" }, { "type": "integer" }],
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer" }
        },
        "paragraph_hash": { "type": ["string", "null"] },
        "path": { "type": "string" },
        "field": { "type": "string" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "item_state",
        "tier",
        "severity",
        "kind",
        "symptom",
        "evidence",
        "fact_ids",
        "depends_on_hash"
      ],
      "properties": {
        "rule_id": { "type": "string" },
        "item_state": { "type": "string" },
        "tier": { "type": "string" },
        "severity": { "type": "string" },
        "kind": { "type": "string" },
        "symptom": { "type": "string", "maxLength": 300 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "fact_ids": { "type": "array", "items": { "type": "string" } },
        "annotation_ids": { "type": "array", "items": { "type": "string" } },
        "depends_on_hash": { "type": "string" },
        "observed": { "type": ["string", "null"] },
        "interpretation": { "type": ["string", "null"] },
        "suggested_fix": { "type": ["string", "null"], "maxLength": 240 },
        "ooc_label": { "type": ["string", "null"] },
        "label": { "type": ["string", "null"] },
        "subject": { "type": ["string", "null"] },
        "chapter": { "type": ["integer", "null"] },
        "agreement": { "type": ["string", "null"] },
        "decision": { "type": ["string", "null"] },
        "tally": { "$ref": "#/$defs/tally" },
        "reads": {
          "type": "array",
          "items": { "$ref": "#/$defs/read" }
        },
        "covered": { "type": "integer" },
        "total": { "type": "integer" }
      }
    },
    "voice_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "sample_count",
        "sample_paragraph_ids",
        "sample_hash",
        "depends_on_hash",
        "register",
        "cadence",
        "syntax",
        "diction",
        "range"
      ],
      "properties": {
        "source": { "type": "string" },
        "sample_count": { "type": "integer" },
        "sample_paragraph_ids": { "type": "array", "items": { "type": "string" } },
        "sample_hash": { "type": "string" },
        "depends_on_hash": { "type": "string" },
        "stale": { "type": "boolean" },
        "register": { "type": "string", "maxLength": 200 },
        "cadence": { "type": "string", "maxLength": 200 },
        "syntax": { "type": "string", "maxLength": 200 },
        "diction": { "type": "string", "maxLength": 200 },
        "range": { "type": "string", "maxLength": 200 }
      }
    },
    "tally": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "break",
        "drift",
        "in_voice",
        "intentional_evolution",
        "not_enough_evidence",
        "rejected"
      ],
      "properties": {
        "break": { "type": "integer" },
        "drift": { "type": "integer" },
        "in_voice": { "type": "integer" },
        "intentional_evolution": { "type": "integer" },
        "not_enough_evidence": { "type": "integer" },
        "rejected": { "type": "integer" }
      }
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "counted_as",
        "evidence_strength",
        "quote",
        "observed",
        "interpretation"
      ],
      "properties": {
        "label": { "type": "string" },
        "counted_as": { "type": "string" },
        "evidence_strength": { "enum": ["sufficient", "thin"] },
        "quote": { "type": "string" },
        "observed": { "type": "string" },
        "interpretation": { "type": "string" }
      }
    }
  }
}
