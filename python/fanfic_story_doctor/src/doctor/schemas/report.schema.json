{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "lens", "items"],
  "properties": {
    "summary": { "type": "string" },
    "lens": {
      "type": "array",
      "items": { "$ref": "#/$defs/lens" }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "lens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "state", "reason"],
      "properties": {
        "rule_id": { "type": "string" },
        "state": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["prose", "file"] },
        "paragraph_id": { "type": "string" },
        "quote": { "type": "string" },
        "path": { "type": "string" },
        "field": { "type": "string" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "item_state",
        "tier",
        "severity",
        "kind",
        "symptom",
        "evidence",
        "fact_ids",
        "depends_on_hash"
      ],
      "properties": {
        "rule_id": { "type": "string" },
        "item_state": { "type": "string" },
        "tier": { "type": "string" },
        "severity": { "type": "string" },
        "kind": { "type": "string" },
        "symptom": { "type": "string", "maxLength": 300 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "fact_ids": { "type": "array", "items": { "type": "string" } },
        "annotation_ids": { "type": "array", "items": { "type": "string" } },
        "depends_on_hash": { "type": "string" },
        "observed": { "type": ["string", "null"] },
        "interpretation": { "type": ["string", "null"] },
        "suggested_fix": { "type": ["string", "null"], "maxLength": 240 },
        "ooc_label": { "type": ["string", "null"] },
        "agreement": { "type": ["string", "null"] },
        "covered": { "type": "integer" },
        "total": { "type": "integer" }
      }
    }
  }
}
